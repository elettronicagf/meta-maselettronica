# short-description: Create SD card image with a boot partition
# long-description:
# Create an image that can be written onto a SD card using dd for use
# with i.MX SoC family
# It uses u-boot + other binaries gathered together on mas-boot file
#
# The disk layout used is:
#  - ---------- -------------- -
# | | mas-boot |    rootfs    |
#  - ---------- -------------- -
# ^ ^          ^              ^
# | |          |              |
# 0 |          |			  |
#	|		 8MiB           3.5GB
#	${IMX_BOOT_SEEK} 32 or 33kiB, see reference manual
#
part u-boot --source rawcopy	--sourceparams="file=mas-boot" --ondisk mmcblk --no-table --align 32
part / 		--source rootfs 	--ondisk mmcblk --fstype=ext4 --label root --align 8192 --fixed-size 2678M
part / 							--ondisk mmcblk --fstype=ext4 --label part2 			--fixed-size 600M

bootloader --ptable msdos

