# ~/.profile: executed by Bourne-compatible login shells.

if [ -f ~/.bashrc ]; then
  . ~/.bashrc
fi

# path set by /etc/profile
PATH="/root/test-mas/gpios/bin:$PATH"
PATH="/root/test-mas:$PATH"
PATH="/sbin:$PATH"
PATH="/usr/sbin:$PATH"
PATH="$HOME:$PATH"
export PATH

# Might fail after "su - myuser" when /dev/tty* is not writable by "myuser".
mesg n 2>/dev/null

